<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>repo2c4-agent</ToolCommandName>
    <PackageId>Repo2C4.Agent</PackageId>
    <Authors>Rodrigo de Oliveira</Authors>
    <Description>Repo2C4 local architecture documentation agent using Microsoft Agent Framework and Repo2C4 MCP.</Description>
    <PackageTags>likec4;c4;architecture;documentation;agent;ai-agent;agent-framework;mcp;dotnet-tool</PackageTags>
    <PackageProjectUrl>https://github.com/rodri-oliveira-dev/Repo2C4</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rodri-oliveira-dev/Repo2C4</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../resource/icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="OllamaSharp" />
  </ItemGroup>
</Project>
