{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.rodri-oliveira-dev/repo2c4-mcp",
  "title": "Repo2C4 MCP",
  "description": "Evidence-first MCP server for reviewable C4 architecture documentation from .NET repositories.",
  "version": "1.0.1",
  "websiteUrl": "https://github.com/rodri-oliveira-dev/Repo2C4",
  "repository": {
    "url": "https://github.com/rodri-oliveira-dev/Repo2C4",
    "source": "github",
    "subfolder": "src/Repo2C4.Mcp"
  },
  "packages": [
    {
      "registryType": "nuget",
      "registryBaseUrl": "https://api.nuget.org/v3/index.json",
      "identifier": "Repo2C4.Mcp",
      "version": "1.0.1",
      "runtimeHint": "dnx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "named",
          "name": "--repository-root",
          "description": "Absolute local repository root that Repo2C4 is authorized to inspect.",
          "format": "filepath",
          "isRequired": true,
          "placeholder": "/absolute/path/to/repository"
        }
      ]
    }
  ]
}
