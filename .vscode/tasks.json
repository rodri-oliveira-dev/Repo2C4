{
  "version": "2.0.0",
  "tasks": [
    {
      "label": ".NET: Restore Tools",
      "type": "process",
      "command": "dotnet",
      "args": [
        "tool",
        "restore"
      ],
      "problemMatcher": []
    },
    {
      "label": ".NET: Restore Dependencies",
      "type": "process",
      "command": "dotnet",
      "args": [
        "restore",
        "Repo2C4.slnx",
        "--locked-mode"
      ],
      "problemMatcher": []
    },
    {
      "label": ".NET: Format",
      "type": "process",
      "command": "dotnet",
      "args": [
        "format",
        "Repo2C4.slnx",
        "--verify-no-changes",
        "--no-restore"
      ],
      "problemMatcher": []
    },
    {
      "label": ".NET: Build Release",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "Repo2C4.slnx",
        "--configuration",
        "Release",
        "--no-restore"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": ".NET: Test Release",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "Repo2C4.slnx",
        "--configuration",
        "Release",
        "--no-build"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": ".NET: Coverage",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "Repo2C4.slnx",
        "--configuration",
        "Release",
        "--no-build",
        "--coverlet",
        "--coverlet-output-format",
        "cobertura"
      ],
      "problemMatcher": []
    }
  ]
}
